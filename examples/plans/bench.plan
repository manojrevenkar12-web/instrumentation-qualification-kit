iqk-plan 1
# The bench plan: module 1 input 0 carries the emulator's time code (10 mV per ms), so time stamps can be scored.
campaign BENCH-SITL
channel timecode    aam:1:0 rate=1000 range_mv=10000 scale=1 offset=0 unit=V
channel strain_a    aam:1:1 rate=1000 range_mv=10000 filter=lp_100hz scale=250 offset=0 unit=ue alarm=-2000,2000
channel strain_b    aam:1:2 rate=1000 range_mv=10000 filter=lp_100hz scale=250 offset=0 unit=ue
channel tc_bay      aam:1:3 rate=10 range_mv=100 filter=lp_10hz scale=2500 offset=0 unit=degC alarm=-40,120
channel static_port aam:2:0 rate=100 range_mv=5000 scale=20 offset=100 unit=kPa
channel gyro_z      imu:gyro_z rate=400
channel accel_z     imu:accel_z rate=200 alarm=-40,40
channel imu_temp    imu:temp rate=50
