iqk-plan 1
# Ground vibration run: wing root strain, two thermocouples, a pressure port and the IMU.
campaign GVT-2026-11-A
channel wing_root_strain aam:1:0 rate=500 range_mv=10000 filter=lp_100hz scale=250 offset=0 unit=ue alarm=-2000,2000
channel spar_strain      aam:1:1 rate=500 range_mv=10000 filter=lp_100hz scale=250 offset=0 unit=ue
channel spar_strain_aft  aam:1:2 rate=500 range_mv=10000 filter=lp_100hz scale=250 offset=0 unit=ue
channel tc_bay_1         aam:1:3 rate=10 range_mv=100 filter=lp_10hz scale=2500 offset=0 unit=degC alarm=-40,120
channel tc_bay_2         aam:1:4 rate=10 range_mv=100 filter=lp_10hz scale=2500 offset=0 unit=degC alarm=-40,120
channel static_port      aam:2:0 rate=100 range_mv=5000 scale=20 offset=100 unit=kPa
channel imu_gyro_z       imu:gyro_z rate=400
channel imu_accel_z      imu:accel_z rate=200 alarm=-40,40
channel imu_temp         imu:temp rate=50
