# expect: accept
# Highest load reachable at or below 60 %: 299985 bit/s = 59.997 %. (Exactly 300000 bit/s cannot be
# reached: 95*M + 135*R with R a multiple of 10 needs M = 60 mod 270 modules.) Catches ceil instead of
# floor in the stuffing term (frames of 96 and 136 bit would give 302208 bit/s).
# CAN: heartbeat 4 B = 8*4+47+floor(65/4)=95 bit; data 8 B = 8*8+47+floor(97/4)=135 bit
# CAN: modules used 3 -> 3*95 = 285 bit/s; groups m1g0@1000, m1g1@200, m2g0@1000, m3g3@20
# CAN: sum of group rates 2220 Hz -> 2220*135 = 299700 bit/s; total 299985 bit/s = 59.997 % of 500 kbit/s (limit 300000)
# TLM: total sample rate 4220 Hz -> 42.2 samples per 10 ms frame -> 1 packet(s); 9*42.2 + 1*(22+4+66) = 471.8 B/frame * 100 * 8 = 377440 bit/s (limit 2000000)
iqk-plan 1
campaign blind1_c01
channel a_fast aam:1:0 rate=1000 range_mv=5000
channel a_mid aam:1:3 rate=200 range_mv=5000
channel b_x aam:2:0 rate=1000 range_mv=5000
channel b_y aam:2:1 rate=1000 range_mv=5000
channel b_z aam:2:2 rate=1000 range_mv=5000
channel c_slow aam:3:11 rate=20 range_mv=5000
