# expect: reject PLN-11
# Telemetry boundary: total 22600 Hz is the most that fits the 2 Mbit/s link (226 samples/frame).
# The CAN bus is far over 60 % (any plan with more than about 9.5 kHz of samples overloads CAN),
# so PLN-12 can only be tested together with PLN-11. Only PLN-11 is broken here.
# CAN: heartbeat 4 B = 8*4+47+floor(65/4)=95 bit; data 8 B = 8*8+47+floor(97/4)=135 bit
# CAN: modules used 3 -> 3*95 = 285 bit/s; groups m1g0@1000, m1g1@1000, m1g2@1000, m1g3@1000, m2g0@1000, m2g1@1000, m2g2@500, m2g3@200, m3g0@100
# CAN: sum of group rates 6800 Hz -> 6800*135 = 918000 bit/s; total 918285 bit/s = 183.657 % of 500 kbit/s (limit 300000)
# TLM: total sample rate 22600 Hz -> 226 samples per 10 ms frame -> 5 packet(s); 9*226 + 5*(22+4+66) = 2494 B/frame * 100 * 8 = 1995200 bit/s (limit 2000000)
iqk-plan 1
campaign blind1_c01
channel imu_gyro_x imu:gyro_x rate=400
channel imu_gyro_y imu:gyro_y rate=400
channel imu_gyro_z imu:gyro_z rate=400
channel imu_accel_x imu:accel_x rate=400
channel imu_accel_y imu:accel_y rate=400
channel imu_accel_z imu:accel_z rate=400
channel imu_temp imu:temp rate=400
channel m1_0 aam:1:0 rate=1000 range_mv=1000
channel m1_1 aam:1:1 rate=1000 range_mv=1000
channel m1_2 aam:1:2 rate=1000 range_mv=1000
channel m1_3 aam:1:3 rate=1000 range_mv=1000
channel m1_4 aam:1:4 rate=1000 range_mv=1000
channel m1_5 aam:1:5 rate=1000 range_mv=1000
channel m1_6 aam:1:6 rate=1000 range_mv=1000
channel m1_7 aam:1:7 rate=1000 range_mv=1000
channel m1_8 aam:1:8 rate=1000 range_mv=1000
channel m1_9 aam:1:9 rate=1000 range_mv=1000
channel m1_10 aam:1:10 rate=1000 range_mv=1000
channel m1_11 aam:1:11 rate=1000 range_mv=1000
channel m2_0 aam:2:0 rate=1000 range_mv=1000
channel m2_1 aam:2:1 rate=1000 range_mv=1000
channel m2_2 aam:2:2 rate=1000 range_mv=1000
channel m2_3 aam:2:3 rate=1000 range_mv=1000
channel m2_4 aam:2:4 rate=1000 range_mv=1000
channel m2_5 aam:2:5 rate=1000 range_mv=1000
channel m2_6 aam:2:6 rate=500 range_mv=1000
channel m2_7 aam:2:7 rate=500 range_mv=1000
channel m2_8 aam:2:8 rate=500 range_mv=1000
