# expect: reject PLN-13
# scale=0 and scale=0.0 (no alarms, so PLN-10 does not apply).
# CAN: heartbeat 4 B = 8*4+47+floor(65/4)=95 bit; data 8 B = 8*8+47+floor(97/4)=135 bit
# CAN: modules used 1 -> 1*95 = 95 bit/s; groups m1g0@100, m1g1@100
# CAN: sum of group rates 200 Hz -> 200*135 = 27000 bit/s; total 27095 bit/s = 5.419 % of 500 kbit/s (limit 300000)
# TLM: total sample rate 200 Hz -> 2 samples per 10 ms frame -> 1 packet(s); 9*2 + 1*(22+4+66) = 110 B/frame * 100 * 8 = 88000 bit/s (limit 2000000)
iqk-plan 1
campaign blind1_c01
channel z1 aam:1:0 rate=100 range_mv=1000 scale=0
channel z2 aam:1:3 rate=100 range_mv=1000 scale=0.0 offset=4
